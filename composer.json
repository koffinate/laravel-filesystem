{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "koffinate/laravel-filesystem",
  "description": "Illuminate filesystem compatibility with Minio Support",
  "keywords": [
    "php", "laravel", "library", "s3", "filesystem", "flysystem",
    "koffinate", "koffin", "coffee",
    "much", "yusron", "arif", "yusronarif"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Much Yusron Arif",
      "email": "yusron.arif4@gmail.com",
      "homepage": "https://yusronarif.github.io",
      "role": "Developer"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.3",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/filesystem": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "league/flysystem-aws-s3-v3": "^3.35"
  },
  "autoload": {
    "psr-4": {
      "Kfn\\Filesystem\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kfn\\Filesystem\\Test\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "2.x-dev"
    },
    "laravel": {
      "providers": [
        "Kfn\\Filesystem\\FilesystemServiceProvider"
      ],
      "aliases": {}
    }
  }
}
